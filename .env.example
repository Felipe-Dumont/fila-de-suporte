# Interface e porta do servidor Python
FILA_HOST=0.0.0.0
FILA_PORT=8001

# Deve ser exatamente o mesmo token configurado no .env do LocarMais
SOLICITAMAIS_API_TOKEN=

# Produção (Supabase/PostgreSQL). Em branco, o app usa data.sqlite.
# Na Vercel, use a URL do Transaction Pooler (porta 6543).
DATABASE_URL=

# Recomendado na Vercel: protege /, /demandas, /alertas, /painel e /kanban.
SOLICITAMAIS_ADMIN_USUARIO=
SOLICITAMAIS_ADMIN_SENHA=
