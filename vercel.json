{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{app.py,configuracao/**,rotas/**,views/**,imagens/**}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index?__caminho=/"
    },
    {
      "source": "/:caminho*",
      "destination": "/api/index?__caminho=/:caminho*"
    }
  ]
}
